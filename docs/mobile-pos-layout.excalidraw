    {"type":"text","id":"note_touch","x":50,"y":110,"width":320,"height":20,"text":"• Touch target minimal 48x48px (Apple HIG)","fontSize":14,"fontFamily":1,"strokeColor":"#888","originalText":"• Touch target minimal 48x48px (Apple HIG)","autoResize":true},
    {"type":"text","id":"note_safe","x":50,"y":130,"width":320,"height":20,"text":"• Safe area insets: top 44px, bottom 34px (notch/home indicator)","fontSize":14,"fontFamily":1,"strokeColor":"#888","originalText":"• Safe area insets: top 44px, bottom 34px (notch/home indicator)","autoResize":true},
    {"type":"text","id":"note_gesture","x":50,"y":150,"width":320,"height":20,"text":"• Gesture: swipe left = hapus item, pull down = refresh","fontSize":14,"fontFamily":1,"strokeColor":"#888","originalText":"• Gesture: swipe left = hapus item, pull down = refresh","autoResize":true},

    {"type":"rectangle","id":"header","x":45,"y":180,"width":330,"height":50,"roundness":{"type":3},"backgroundColor":"#1e1e32","fillStyle":"solid","strokeColor":"#333","boundElements":[{"id":"hdr_text","type":"text"}]},
    {"type":"text","id":"hdr_text","x":130,"y":190,"width":160,"height":25,"text":"HEADER — Search + User","fontSize":16,"fontFamily":1,"strokeColor":"#e8c39e","containerId":"header","originalText":"HEADER — Search + User","autoResize":true},
    {"type":"arrow","id":"arr1","x":210,"y":230,"width":0,"height":20,"endArrowhead":"arrow","points":[[0,0],[0,20]]},

