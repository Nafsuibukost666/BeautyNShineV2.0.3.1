    {"type":"text","id":"sb_text","x":100,"y":315,"width":220,"height":100,"text":"DAFTAR LAYANAN\nHorizontal scroll cards\n(drag finger kiri/kanan)\n\n• Icon + Nama + Harga\n• Tap untuk tambah ke keranjang","fontSize":14,"fontFamily":1,"strokeColor":"#ccc","containerId":"service_bar","originalText":"DAFTAR LAYANAN\nHorizontal scroll cards\n(drag finger kiri/kanan)\n\n• Icon + Nama + Harga\n• Tap untuk tambah ke keranjang","autoResize":true},

