    {"type":"text","id":"bb_text","x":70,"y":720,"width":280,"height":40,"text":"BOTTOM — Total Rp xxx.xxx  |  [BAYAR]","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","containerId":"bottom_bar","originalText":"BOTTOM — Total Rp xxx.xxx  |  [BAYAR]","autoResize":true},

