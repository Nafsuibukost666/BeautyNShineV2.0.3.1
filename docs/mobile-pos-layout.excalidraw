      "x": 50, "y": 78, "width": 320, "height": 20,
      "text": "(Layout ini untuk HP portrait / tablet landscape)", "fontSize": 14,
      "fontFamily": 1, "strokeColor": "#888",
      "originalText": "(Layout ini untuk HP portrait / tablet landscape)",
      "autoResize": true
